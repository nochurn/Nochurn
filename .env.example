# Database Configuration (Railway PostgreSQL in production)
DATABASE_URL="postgresql://postgres:password@postgres.railway.internal:5432/railway"
NODE_ENV="production"
PORT=3000

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Razorpay Subscriptions Configuration (Currency: USD)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Authoritative Razorpay Plan IDs (USD)
RAZORPAY_STARTER_MONTHLY_PLAN_ID="plan_TeZlsQOQaeAWAw"
RAZORPAY_STARTER_ANNUAL_PLAN_ID="plan_TeZMQYLVPEtQuj"
RAZORPAY_GROWTH_MONTHLY_PLAN_ID="plan_TeZQFjmJoxrnKM"
RAZORPAY_GROWTH_ANNUAL_PLAN_ID="plan_TeZwr5wS1PyVhH"
RAZORPAY_ENTERPRISE_MONTHLY_PLAN_ID="plan_TeZraPPrYthtEk"
RAZORPAY_ENTERPRISE_ANNUAL_PLAN_ID="plan_Tea17dB6H4EHdn"

# Supabase Auth & Database Configuration
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SITE_URL=""

# WhatsApp Business Cloud API (Server-Side Only)
# Meta Graph API credentials for sending WhatsApp notifications to customers
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Resend Email Sending API (Server-Side Only)
# API key from resend.com for outbound customer retention emails
RESEND_API_KEY=""
# Sender address, e.g. "NoChurn <onboarding@resend.dev>" or "support@yourdomain.com"
RESEND_FROM_EMAIL="NoChurn <onboarding@resend.dev>"


